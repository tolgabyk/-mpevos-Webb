{
  "installCommand": "npm install && npm install formidable",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/join-team/apply.js": {
      "maxDuration": 60,
      "memory": 1024
    }
  },
  "rewrites": [
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
